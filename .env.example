# ---- Claude API (leave empty to run the offline rule engine) ----
ANTHROPIC_API_KEY=
BONDCHECK_FAST_MODEL=claude-haiku-4-5        # classification, PII checks, OCR
BONDCHECK_STRONG_MODEL=claude-sonnet-5-5     # extraction, Q&A, research
# BONDCHECK_OFFLINE=1                        # force the offline engine even with a key

# ---- Database (leave empty for local SQLite at data/bondcheck.db) ----
# Neon / Supabase PostgreSQL. Run db/schema.sql, then db/seed.sql (optional demo data).
DATABASE_URL=
# Read-only role used by the Q&A agent's text-to-SQL (see the bottom of db/schema.sql)
DATABASE_URL_READONLY=

# ---- Guardrails ----
BONDCHECK_TOKEN_BUDGET=80000
BONDCHECK_MAX_RETRIES=2
BONDCHECK_CONFIDENCE_THRESHOLD=0.75

# ---- Admin, cron, email ----
ADMIN_TOKEN=change-me
CRON_SECRET=change-me-too
RESEND_API_KEY=                              # empty: alert emails are written to data/outbox/
ALERT_FROM_EMAIL=BondCheck <alerts@yourdomain.com>
SITE_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# ---- OCR (optional) ----
# TESSERACT_CMD=tesseract                    # used if installed; otherwise Claude vision (needs API key)
